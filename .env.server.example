# Segredos do SERVIDOR. Copie para .env.server.local (ignorado pelo Git).
# Nada daqui pode ir para o app: o app só conhece mobile/.env (EXPO_PUBLIC_*).
# Guia de integração: documentos/Integracao_backend.md

# --- E-mail do código de entrada (Resend) -----------------------------------
# O Supabase Auth gera e valida o código; o Resend só entrega por SMTP.
# No painel do Supabase (Auth > SMTP), use: host smtp.resend.com, porta 465,
# usuário "resend", senha = RESEND_API_KEY, remetente = RESEND_FROM_EMAIL.
# Modelo do e-mail "Magic link/OTP" com {{ .Token }}; comprimento do OTP: 6.
RESEND_API_KEY=
# Remetente confirmado: Divide aí <acesso@divideai.com> (domínio ainda sem DNS validado)
RESEND_FROM_EMAIL=

# --- Supabase (apenas funções/migrations no servidor) ------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Geocodificação/rotas com cobrança (proxy no servidor, com cota por usuário)
GEOCODER_API_KEY=

# --- Worker de rotas a pé (supabase/worker/routes.mjs; roda no servidor) ------
# osrm: servidor OSRM com perfil foot (próprio, sem custo) | ors: openrouteservice
ROUTE_PROVIDER=
ROUTE_BASE_URL=
ROUTE_API_KEY=
