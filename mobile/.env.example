# Divide aí — configuração do app (Expo lê este arquivo copiado como `.env`).
#
#   cp .env.example .env        (no PowerShell: Copy-Item .env.example .env)
#
# ATENÇÃO: tudo com prefixo EXPO_PUBLIC_ vai DENTRO do pacote do app e fica
# visível para qualquer pessoa. Nunca coloque aqui chave secreta (service_role,
# Resend, Google com cobrança sem restrição). Segredos ficam no servidor:
# veja ../.env.server.example. Edite o .env e reinicie o `expo start`/exporte de novo.
# Detalhes de cada variável e dos corpos das rotas: ../documentos/Integracao_backend.md
#
# Tudo vazio = o app funciona como hoje (demonstração, sem backend).

# ---------------------------------------------------------------------------
# 1) Fonte dos dados: demo (padrão; tudo em memória, com companhias simuladas)
#    ou api (backend real, usando os endpoints abaixo).
# ---------------------------------------------------------------------------
EXPO_PUBLIC_DATA_SOURCE=demo

# URL base do backend, sem barra no fim. Ex.: https://abcdxyz.supabase.co
# (https obrigatório; http só em localhost/10.0.2.2/rede local, para desenvolver)
EXPO_PUBLIC_API_BASE_URL=

# Chave PÚBLICA do backend, enviada no cabeçalho `apikey`.
# Supabase: a chave "anon"/"publishable". Nunca a service_role.
EXPO_PUBLIC_API_KEY=

# Tempo máximo de cada chamada (ms; 1000–120000; padrão 15000) e intervalo da
# atualização automática do estado (ms; 0 desliga; padrão 5000).
EXPO_PUBLIC_API_TIMEOUT_MS=
EXPO_PUBLIC_API_POLL_MS=

# ---------------------------------------------------------------------------
# 2) Endpoints do backend. Formato: "/caminho" (método padrão do grupo) ou
#    "MÉTODO /caminho" (GET, POST, PUT, PATCH, DELETE) ou URL completa https.
#    Vazio = não configurado (a ação falha com aviso claro em vez de quebrar).
#    Ex. Supabase RPC: POST /rest/v1/rpc/get_state
# ---------------------------------------------------------------------------

# Obter (padrão GET)
EXPO_PUBLIC_API_STATE_GET=
EXPO_PUBLIC_API_CANDIDATES_GET=
EXPO_PUBLIC_API_MESSAGES_GET=
EXPO_PUBLIC_API_HISTORY_GET=

# Escrever (padrão POST). Cada uma devolve o estado atualizado.
EXPO_PUBLIC_API_PROFILE_SAVE=
EXPO_PUBLIC_API_INTENT_SAVE=
EXPO_PUBLIC_API_INTENT_CANCEL=
EXPO_PUBLIC_API_REQUEST_SEND=
EXPO_PUBLIC_API_REQUEST_CANCEL=
EXPO_PUBLIC_API_REQUEST_DECLINE=
EXPO_PUBLIC_API_PROPOSAL_PICK=
EXPO_PUBLIC_API_MESSAGE_SEND=
EXPO_PUBLIC_API_NEGOTIATION_END=
EXPO_PUBLIC_API_TRIP_OUTCOME=
EXPO_PUBLIC_API_REVIEW_SEND=
EXPO_PUBLIC_API_TRIP_CLOSE=
EXPO_PUBLIC_API_REPORT_SEND=
EXPO_PUBLIC_API_BLOCK_ADD=
EXPO_PUBLIC_API_BLOCK_REMOVE=

# ---------------------------------------------------------------------------
# 3) Login por código de e-mail.
#    demo     = código fixo 123456, nenhum e-mail enviado (padrão).
#    supabase = Supabase Auth: o SERVIDOR envia o e-mail (SMTP do Resend
#               configurado no painel do Supabase) e confere o código.
#               Usa a URL abaixo (ou a API_BASE_URL) e a EXPO_PUBLIC_API_KEY.
#    A chave do Resend NUNCA entra no app: fica só no servidor.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_AUTH_PROVIDER=demo
EXPO_PUBLIC_AUTH_BASE_URL=

# ---------------------------------------------------------------------------
# 4) Busca de endereços.
#    photon = Photon público (padrão; gratuito, sem SLA, só para demonstração).
#    api    = seu backend (proxy de Google Places, Mapbox etc., com chave e cota
#             no servidor). Usa GEOCODER_URL ou a API_BASE_URL como base.
#             Formato da resposta em documentos/Integracao_backend.md.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_GEOCODER_PROVIDER=photon
# photon: base do Photon (padrão https://photon.komoot.io; pode ser um Photon seu)
EXPO_PUBLIC_GEOCODER_URL=
# api: caminhos GET de busca e de endereço-a-partir-do-ponto
EXPO_PUBLIC_GEOCODER_SEARCH=
EXPO_PUBLIC_GEOCODER_REVERSE=
# Intervalo mínimo entre consultas (ms). Padrão 1200 no Photon público, 0 na api.
EXPO_PUBLIC_GEOCODER_INTERVAL_MS=

# ---------------------------------------------------------------------------
# 5) Mapa (tiles). Padrão: OpenStreetMap, aceitável só para demonstração e uso
#    leve (política: https://operations.osmfoundation.org/policies/tiles/).
#    Para produção, use um provedor contratado. Modelo Leaflet com {z}/{x}/{y},
#    opcionais {s} (subdomínios) e {r} (retina). Chave pública vai na própria URL.
#    Ex.: https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=SUA_CHAVE_PUBLICA
# ---------------------------------------------------------------------------
EXPO_PUBLIC_MAP_TILE_URL=
EXPO_PUBLIC_MAP_TILE_MAX_ZOOM=
# Crédito exigido pelo provedor dos tiles (texto e link https).
EXPO_PUBLIC_MAP_ATTRIBUTION_TEXT=
EXPO_PUBLIC_MAP_ATTRIBUTION_URL=
