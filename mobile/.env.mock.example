# Aponta o app para o backend FALSO (tools/mock_backend.mjs). Só para testar a
# integração localmente. Não copie valores reais aqui.
#
#   node --experimental-strip-types tools/mock_backend.mjs
#   (Git Bash) export MSYS_NO_PATHCONV=1   # senão o Git Bash troca "/api/x" por "C:/Program Files/Git/api/x"
#   (bash) set -a; . ./.env.mock.example; set +a; npx expo export --platform web --output-dir dist/web-api --clear
#   (PowerShell) Get-Content .env.mock.example | ? { $_ -match '^EXPO_PUBLIC_' } | % { $k,$v = $_ -split '=',2; Set-Item "env:$k" $v }
#   python tools/serve_catalog.py dist/web-api 8082
EXPO_PUBLIC_DATA_SOURCE=api
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8787
EXPO_PUBLIC_API_KEY=mock-public-key
EXPO_PUBLIC_API_POLL_MS=2000
EXPO_PUBLIC_API_STATE_GET=/api/state
EXPO_PUBLIC_API_CANDIDATES_GET=/api/candidates
EXPO_PUBLIC_API_MESSAGES_GET=/api/messages
EXPO_PUBLIC_API_HISTORY_GET=/api/history
EXPO_PUBLIC_API_PROFILE_SAVE=/api/profile
EXPO_PUBLIC_API_INTENT_SAVE=/api/intent
EXPO_PUBLIC_API_INTENT_CANCEL=/api/intent/cancel
EXPO_PUBLIC_API_REQUEST_SEND=/api/request
EXPO_PUBLIC_API_REQUEST_CANCEL=/api/request/cancel
EXPO_PUBLIC_API_REQUEST_DECLINE=/api/request/decline
EXPO_PUBLIC_API_PROPOSAL_PICK=/api/proposal/pick
EXPO_PUBLIC_API_MESSAGE_SEND=/api/messages
EXPO_PUBLIC_API_NEGOTIATION_END=/api/negotiation/end
EXPO_PUBLIC_API_TRIP_OUTCOME=/api/trip/outcome
EXPO_PUBLIC_API_REVIEW_SEND=/api/review
EXPO_PUBLIC_API_TRIP_CLOSE=/api/trip/close
EXPO_PUBLIC_API_REPORT_SEND=/api/report
EXPO_PUBLIC_API_BLOCK_ADD=/api/block
EXPO_PUBLIC_API_BLOCK_REMOVE=/api/block/remove
EXPO_PUBLIC_AUTH_PROVIDER=supabase
EXPO_PUBLIC_GEOCODER_PROVIDER=api
EXPO_PUBLIC_GEOCODER_SEARCH=/api/places/search
EXPO_PUBLIC_GEOCODER_REVERSE=/api/places/reverse
