# Aponta o app para um projeto SUPABASE com as migrations de ../supabase aplicadas.
# Copie para .env e preencha só as duas linhas marcadas. Nada aqui é segredo:
# tudo com prefixo EXPO_PUBLIC_ vai dentro do app. NUNCA ponha a chave
# service_role nem a do Resend neste arquivo (elas ficam só no servidor).
#
# Depois de trocar valores, exporte com cache limpo: npm run export:web (já usa --clear)
# ou npx expo start -c. Passo a passo em ../documentos/Integracao_backend.md.
EXPO_PUBLIC_DATA_SOURCE=api

# <<< PREENCHER >>> URL do projeto, ex.: https://abcd1234.supabase.co
EXPO_PUBLIC_API_BASE_URL=
# <<< PREENCHER >>> chave pública (anon/publishable) do projeto
EXPO_PUBLIC_API_KEY=

EXPO_PUBLIC_API_POLL_MS=5000

# Leituras: o PostgREST só aceita GET em funções sem efeito; estas avançam prazos
# e entregam avisos, então são POST (o app manda { resource, negotiation }).
EXPO_PUBLIC_API_STATE_GET=POST /rest/v1/rpc/app_state
EXPO_PUBLIC_API_CANDIDATES_GET=POST /rest/v1/rpc/app_candidates
EXPO_PUBLIC_API_MESSAGES_GET=POST /rest/v1/rpc/app_messages
EXPO_PUBLIC_API_HISTORY_GET=POST /rest/v1/rpc/app_history

EXPO_PUBLIC_API_PROFILE_SAVE=/rest/v1/rpc/app_profile_save
EXPO_PUBLIC_API_INTENT_SAVE=/rest/v1/rpc/app_intent_save
EXPO_PUBLIC_API_INTENT_CANCEL=/rest/v1/rpc/app_intent_cancel
EXPO_PUBLIC_API_REQUEST_SEND=/rest/v1/rpc/app_request_send
EXPO_PUBLIC_API_REQUEST_CANCEL=/rest/v1/rpc/app_request_cancel
EXPO_PUBLIC_API_REQUEST_DECLINE=/rest/v1/rpc/app_request_decline
EXPO_PUBLIC_API_PROPOSAL_PICK=/rest/v1/rpc/app_proposal_pick
EXPO_PUBLIC_API_MESSAGE_SEND=/rest/v1/rpc/app_message_send
EXPO_PUBLIC_API_NEGOTIATION_END=/rest/v1/rpc/app_negotiation_end
EXPO_PUBLIC_API_TRIP_OUTCOME=/rest/v1/rpc/app_trip_outcome
EXPO_PUBLIC_API_REVIEW_SEND=/rest/v1/rpc/app_review_send
EXPO_PUBLIC_API_TRIP_CLOSE=/rest/v1/rpc/app_trip_close
EXPO_PUBLIC_API_REPORT_SEND=/rest/v1/rpc/app_report_send
EXPO_PUBLIC_API_BLOCK_ADD=/rest/v1/rpc/app_block_add
EXPO_PUBLIC_API_BLOCK_REMOVE=/rest/v1/rpc/app_block_remove

# Login por código no e-mail (Supabase Auth; o envio é do servidor, via SMTP do Resend).
EXPO_PUBLIC_AUTH_PROVIDER=supabase

# Endereços: o Photon público serve a demonstração. Para produção, um proxy
# seu (provedor com chave guardada no servidor) em EXPO_PUBLIC_GEOCODER_PROVIDER=api.
EXPO_PUBLIC_GEOCODER_PROVIDER=photon
